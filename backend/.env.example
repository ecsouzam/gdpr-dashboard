# Optional overrides. Copy to `.env` and adjust if needed.
# By default the backend auto-detects the Windows host IP from WSL2's
# default route, so these are only needed for unusual setups.

# Force a specific Ollama host IP instead of auto-detecting it.
# OLLAMA_HOST_IP=172.25.240.1

# Port Ollama is listening on (default: 11434)
# OLLAMA_PORT=11434

# Model name to request from Ollama (default: qwen2.5:7b)
# OLLAMA_MODEL=qwen2.5:7b

# How long to wait for Ollama to respond, in seconds (default: 300)
# OLLAMA_TIMEOUT_SECONDS=300
